# Copy this file to .env and set paths to the private Obsidian Markdown files.
# Never commit .env or any private source data.
# TAM essentials: quick notes and explanations (01-40, then 41-80).
DRILL_TAM_CORE_PATH=
DRILL_TAM_CORE_NOTES_PATH=
DRILL_TAM_EXTENSION_PATH=
DRILL_TAM_EXTENSION_NOTES_PATH=

# TOEIC S&W/daily sentence drills and the app-wide glossary have separate sources.
# English/TOEIC S&W/TOEIC S&W・日常英語 ドリルマスター.md
DRILL_TOEIC_MASTER_PATH=
# English/共通英語用語集.md
DRILL_GLOSSARY_PATH=

# Optional TAM-only acceptance checks. The current edition has 80 unclassified cards.
DRILL_EXPECTED_TOTAL=
DRILL_EXPECTED_REVIEW=
DRILL_EXPECTED_MASTERED=
DRILL_EXPECTED_REGULAR=
