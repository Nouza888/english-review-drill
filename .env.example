# Copy this file to .env and set paths to the two private Obsidian Markdown files.
# Never commit .env or any private source data.
DRILL_MASTER_PATH=
DRILL_REVIEW_PATH=

# Optional one-time seed acceptance checks. Leave blank for normal future updates.
DRILL_EXPECTED_TOTAL=
DRILL_EXPECTED_REVIEW=
DRILL_EXPECTED_MASTERED=
DRILL_EXPECTED_REGULAR=
DRILL_EXPECTED_REVIEW_ROWS=
