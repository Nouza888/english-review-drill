{
  "name": "english-review-drill",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate:data": "node scripts/validate-data.mjs public/data/cards.json && node scripts/validate-library.mjs",
    "sync:data": "node scripts/sync-data.mjs && node scripts/sync-library.mjs",
    "sync:library": "node scripts/sync-library.mjs",
    "check": "npm run typecheck && npm run test && npm run validate:data && npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
